# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules
__pycache__/
*.py[cod]
services/music-ai-worker/.readiness/
services/music-ai-worker/.artifacts/
services/music-ai-worker/licensed_assets.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Local development
.env.local
.env.*.local
.local-object-store/

# Files uploaded into chat are local working inputs, not source files.
# Already tracked assets remain tracked; new uploads must not block Git Sync.
attached_assets/

# Private licensed-instrument manifests and render worker state (never commit)
.local-vst3-assets/

# Plugin hosts write this into the working directory
debug.log

# Third-party research datasets fetched by the acquisition pipelines (Wave Q,
# Q-05). Hundreds of megabytes of other people's data: never a file, never an
# LFS pointer. pdmxAcquisition.targetDirectoryRefusal refuses any target that
# is not listed here.
.pdmx-data/
.corpus-data/

# Local esbuild test bundles (see docs: focused runner cannot spawn esbuild on Windows)
.tmp-tests/

# Training datasets, checkpoints and run directories (Wave Q, PR-63). Built
# from the read-only PDMX corpus by services/composers-assistant-train; only
# manifests and digests are committed, never examples or weights.
.training-data/
services/composers-assistant-train/runs/
services/composers-assistant-train/exports/
services/composers-assistant-train/.smoke/
        ["--alias:@workspace/db=./src/lib/musicProviders.testDbStub.ts"],
      ],
# Workstream worktree marker: a local signal that dependencies are installed.
.deps-ready

# PR-83 (stream C): transcription sweep scratch — worker token, rendered WAVs,
# raw worker output. The gold set and the scored evidence live in docs/evidence/.
.amt-bench/
