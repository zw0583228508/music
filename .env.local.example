# Local development environment for the API server.
# Copy to `.env.local` and adjust. `.env.local` is git-ignored.
#
#   cp .env.local.example .env.local
#
# Load it into your shell before starting the API server, e.g.:
#   set -a; . ./.env.local; set +a
#   pnpm --filter @workspace/api-server run dev

# --- Required ---------------------------------------------------------------

# Postgres connection string (local PostgreSQL 16).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/music_studio

# API server port. The studio dev proxy targets http://localhost:5000.
PORT=5000

NODE_ENV=development

# --- Local object storage (filesystem instead of Replit Object Storage) -----

MUSIC_OBJECT_STORAGE_DRIVER=local
LOCAL_OBJECT_STORAGE_DIR=./.local-object-store
# parseObjectPath() needs >=2 path segments: <bucket>/<dir>.
PRIVATE_OBJECT_DIR=/local/private
PUBLIC_BASE_URL=http://localhost:5000

# --- Reaching a cloud analysis worker (Wave Q) -----------------------------
# A cloud worker cannot fetch http://localhost:5000, and its SSRF guard is
# right to refuse it. Do NOT solve this by tunnelling to the API: this API
# mounts /api/dev-login below, which mints a full session for anyone who asks
# and reaches the database.
#
# Instead point the tunnel at ANALYSIS_ASSET_PORT. That surface has one route,
# GET /a/<256-bit token>, serves only objects a run explicitly leased, expires
# them, and can write nothing. Both variables are required, and the base must
# be https and globally resolvable or the surface refuses to start.
#
# ANALYSIS_ASSET_PORT=5010
# ANALYSIS_ASSET_BASE_URL=https://<your-tunnel-host>

# --- Local dev sign-in (bypasses Replit OIDC) ------------------------------
# WARNING: with this on, GET /api/dev-login signs in any caller with no
# credentials. Keep the API bound to localhost. Never tunnel this port.
# Visit http://localhost:5173/api/dev-login once to get a session cookie.

DEV_AUTH_ENABLED=true
DEV_AUTH_USER_ID=dev-local-user
DEV_AUTH_USER_EMAIL=dev@localhost

# --- Optional ------------------------------------------------------------------

LOG_LEVEL=debug
# Admin surface access for the local dev user.
MUSIC_STUDIO_ADMIN_EMAILS=dev@localhost

# Model workers stay offline locally. Leave provider *_API_URL vars unset;
# the studio will not fabricate candidates when workers are unavailable.

# --- PR-21: local VST3 render worker (services/vst3-render-worker) ---------
# Renders Performance MIDI through instruments you already own (e.g. Steinberg
# Retrologue) via pedalboard, in a separate worker process. Setup and the
# fail-closed smoke are described in services/vst3-render-worker/README.md.
# PEDALBOARD_VST3_API_URL=http://127.0.0.1:8022
# PEDALBOARD_VST3_API_TOKEN=<same secret as VST3_RENDER_TOKEN>
# VST3_RENDER_TOKEN=<random secret>
# VST3_RENDER_ASSET_MANIFEST=.local-vst3-assets/asset-manifest.json
# VST3_RENDER_STATE_DIR=.local-vst3-assets/state

# PR-22: which attested VST3 instrument renders which track (asset ids from the
# worker manifest). Precedence: byInstrument > byRole > byFamily > default. A
# rule naming an instrument the worker has not attested makes that track fall
# back to the preview synth with the reason recorded -- never a silent swap.
# PREMIUM_INSTRUMENT_ROUTING={"default":"retrologue-2.4.0","byFamily":{"drums":"groove-agent-se-5.2.20"},"byRole":{"PAD":"padshop-2.2.0"}}
# PREMIUM_INSTRUMENT_ROUTING_PATH=.local-vst3-assets/routing.json
