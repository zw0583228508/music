  "spec": "docs/brain/reviews/2026-09-10-audit-evaluation-and-loops.md §7 (7.1 measure, 7.2 corpus, 7.3 snapshot, 7.4 ledger, 7.5 human A/B)",
  "whatChangedInTheMeasure": {
    "benchmarkVersion": {
      "before": "1.0",
      "after": "2.0"
    },
    "harmonyScore": "before: the critic's harmony dimension (reads the Song Model only; 58.33 for every composer). after: 100 x (chordToneShare - clashShare) on the selected candidate's pitched, performed notes vs the Song Model chords, via partJudge.chordToneShare / contextClashShare. The old number is kept as sourceHarmonyScore (informational).",
    "shippedCriticScore": "new: critiqueArrangement on the performed tracks the selected candidate returns, beside the orchestrator's own criticScore (pre-performance notes after the plan-only repair loop).",
    "sectionConsistency": "replaced by coherence trajectorySmoothness / seamArtefacts / motifRecurrence (COHERENCE_METRIC_v1 on the selected candidate with the plan's section targets); kept one release as legacySectionConsistency.",
    "candidateDiversity": "replaced by candidateDistance = 100 x mean pairwise candidateDiversity.candidateDistance over the run's candidates (the production gate's own measure); kept one release as legacyCandidateDiversity.",
    "pins": "every BenchmarkRun carries gitSha, render flag, tier, corpusIds and metricVersions {musicCritic, audioCritic, partJudge, coherenceMetric, benchmarkMeasures}; compareBenchmarkRuns refuses (outcome incomparable) across a different benchmark version, tier, render flag, corpus or metric pin.",
    "cli": "benchmark-cli: --out <file>, --compare <baseline.json> (verdict table; exit 1 on do_not_promote unless --no-fail; exit 2 when incomparable), --tier S|P, --candidates N; repo-relative paths resolved against the workspace root."
  },
